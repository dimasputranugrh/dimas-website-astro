---
import ChapterLabel from '../ChapterLabel.astro';
---

<section id="contact" class="section pb-24 sm:pb-28">
	<div class="shell">
		<ChapterLabel index="05" title="Contact" note="Replies by email" />

		<div class="mt-12 grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
			<div class="min-w-0">
				<h2 class="display-xl text-balance" data-reveal="up">
					Let's <span class="italic">talk.</span>
				</h2>
				<p class="mt-6 max-w-[42ch] text-base leading-8 text-muted" data-reveal="up" style="--d: 100ms">
					Send a short brief: goal, main features, references, and deadline. I reply by email.
				</p>

				<div class="mt-8" data-reveal="up" style="--d: 180ms">
					<button
						class="copy-email"
						type="button"
						data-copy-email
						data-email="dimasputranugrh@gmail.com"
						aria-label="Copy email address dimasputranugrh@gmail.com"
					>
						<span class="min-w-0">dimasputranugrh@gmail.com</span>
						<span class="copy-label" data-copy-label aria-live="polite">Copy</span>
					</button>
				</div>

				<dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-6 border-t border-line pt-6" data-reveal="up" style="--d: 240ms">
					<div>
						<dt class="overline text-muted">Location</dt>
						<dd class="mt-1.5 text-sm font-semibold">Indonesia</dd>
					</div>
					<div>
						<dt class="overline text-muted">Time</dt>
						<dd class="mt-1.5 text-sm font-semibold">WIB <span data-clock>--:--</span></dd>
					</div>
					<div>
						<dt class="overline text-muted">Status</dt>
						<dd class="mt-1.5 inline-flex items-center gap-2 text-sm font-semibold">
							<span class="h-1.5 w-1.5 bg-accent" aria-hidden="true"></span>
							Open to freelance
						</dd>
					</div>
					<div>
						<dt class="overline text-muted">LinkedIn</dt>
						<dd class="mt-1.5 text-sm font-semibold">
							<a
								class="underline decoration-line-strong underline-offset-4 hover:decoration-accent"
								href="https://www.linkedin.com/in/dimasputranugrh/"
								target="_blank"
								rel="noreferrer">dimasputranugrh</a
							>
						</dd>
					</div>
				</dl>
			</div>

			<form
				class="form-shell"
				name="contact"
				method="POST"
				action="/#contact"
				data-netlify="true"
				netlify-honeypot="bot-field"
				data-contact-form
				data-reveal="up"
				style="--d: 160ms"
			>
				<input type="hidden" name="form-name" value="contact" />
				<label class="hidden" aria-hidden="true">
					<span>Leave this empty:</span>
					<input name="bot-field" tabindex="-1" autocomplete="off" />
				</label>

				<div class="grid gap-6" data-form-fields>
					<label class="grid gap-2" for="contact-name">
						<span class="field-label">Name</span>
						<input
							class="field-input"
							id="contact-name"
							name="name"
							type="text"
							placeholder="Your name"
							autocomplete="name"
							required
						/>
					</label>

					<label class="grid gap-2" for="contact-email">
						<span class="field-label">Email</span>
						<input
							class="field-input"
							id="contact-email"
							name="email"
							type="email"
							placeholder="you@email.com"
							autocomplete="email"
							required
						/>
					</label>

					<label class="grid gap-2" for="contact-message">
						<span class="field-label">Message</span>
						<textarea
							class="field-input"
							id="contact-message"
							name="message"
							rows="5"
							placeholder="Tell me about the project..."
							required></textarea>
					</label>

					<div class="flex flex-wrap items-center justify-between gap-4">
						<button class="btn btn-primary magnetic w-full sm:w-auto" type="submit" data-submit>
							<span class="btn-dot" aria-hidden="true"></span>
							<span data-submit-label>Send message</span>
						</button>
						<p class="font-mono text-[10px] uppercase leading-5 tracking-[0.12em] text-muted">
							I reply by email
						</p>
					</div>

					<p class="form-status" data-form-status role="status" aria-live="polite"></p>
				</div>

				<div class="form-success" data-form-success hidden>
					<p class="display-m">Message sent.</p>
					<p class="mt-2 text-sm leading-7 text-muted">I'll reply by email.</p>
					<button class="btn btn-line btn-small mt-5" type="button" data-form-reset>Send another message</button>
				</div>
			</form>
		</div>
	</div>
</section>
