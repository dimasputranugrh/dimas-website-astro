---
import { getImage } from 'astro:assets';
import profileImageDark from '../../assets/image.png';
import profileImageLight from '../../assets/image_white.png';

const portraitLight = await getImage({ src: profileImageLight, width: 960, format: 'webp', quality: 82 });
const portraitDark = await getImage({ src: profileImageDark, width: 960, format: 'webp', quality: 82 });

const tickerItems = [
	'Design system',
	'Accessibility',
	'Performance',
	'TypeScript',
	'Next.js',
	'React',
	'Astro',
	'Code review',
];
---

<section id="top" class="relative overflow-hidden pb-14 pt-24 sm:pt-28 lg:pb-16 lg:pt-32" data-hero>
	<div class="shell grid gap-14 lg:grid-cols-[1.25fr_0.75fr] lg:items-center lg:gap-16">
		<div class="min-w-0">
			<div class="flex items-center gap-4">
				<span class="h-1.5 w-1.5 flex-none bg-accent" aria-hidden="true"></span>
				<span class="overline text-muted">Dimas Putra, Lead Frontend Developer</span>
				<span class="hidden h-px flex-1 bg-line sm:block" aria-hidden="true"></span>
				<span class="overline hidden text-muted sm:inline">Indonesia / WIB</span>
			</div>

			<h1 class="display-hero mt-7">
				<span class="line-mask" style="--d: 120ms"><span>Web that</span></span>
				<span class="line-mask" style="--d: 210ms"><span>feels</span></span>
				<span class="line-mask line-mask-rule" style="--d: 300ms"><span class="accent-word">designed.</span></span>
			</h1>

			<p
				class="mt-10 max-w-[52ch] text-pretty text-base leading-7 text-muted sm:text-lg sm:leading-8"
				data-reveal="up"
				style="--d: 470ms"
			>
				Seven years turning design into shipped web products: fast, consistent, and easy to use. Now leading the
				frontend team at MIFX.
			</p>

			<div class="mt-9 flex flex-wrap items-center gap-3" data-reveal="up" style="--d: 560ms">
				<a class="btn btn-primary magnetic" data-magnetic href="mailto:dimasputranugrh@gmail.com">
					<span class="btn-dot" aria-hidden="true"></span>
					Send a project brief
				</a>
				<a class="btn btn-line magnetic" data-magnetic href="#work">See all 17 projects</a>
			</div>

			<dl class="mt-12 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-line pt-6 sm:grid-cols-4" data-reveal="up" style="--d: 650ms">
				<div>
					<dt class="overline text-muted">Based in</dt>
					<dd class="mt-1.5 text-sm font-semibold">Indonesia</dd>
				</div>
				<div>
					<dt class="overline text-muted">Experience</dt>
					<dd class="mt-1.5 text-sm font-semibold">7+ years</dd>
				</div>
				<div>
					<dt class="overline text-muted">Work</dt>
					<dd class="mt-1.5 text-sm font-semibold">17 projects</dd>
				</div>
				<div>
					<dt class="overline text-muted">Status</dt>
					<dd class="mt-1.5 inline-flex items-center gap-2 text-sm font-semibold">
						<span class="h-1.5 w-1.5 bg-accent" aria-hidden="true"></span>
						Open to freelance
					</dd>
				</div>
			</dl>
		</div>

		<div class="relative mx-auto w-full max-w-[27rem] lg:max-w-none" data-reveal="up" style="--d: 220ms">
			<figure class="portrait-frame tilt" data-tilt>
				<div class="portrait-inner" data-reveal="mask" style="--d: 320ms">
					<img
						class="dark:hidden"
						src={portraitLight.src}
						width={profileImageLight.width}
						height={profileImageLight.height}
						alt="Portrait of Dimas Putra"
						loading="eager"
						decoding="async"
						fetchpriority="high"
					/>
					<img
						class="hidden dark:block"
						src={portraitDark.src}
						width={profileImageDark.width}
						height={profileImageDark.height}
						alt="Portrait of Dimas Putra"
						loading="eager"
						decoding="async"
						fetchpriority="high"
					/>
				</div>
				<figcaption class="portrait-caption">
					<span>Dimas Putra</span>
					<span>MIFX / 2022 to now</span>
				</figcaption>
			</figure>

			<div class="stamp hidden sm:grid" aria-hidden="true">
				<svg viewBox="0 0 120 120">
					<defs>
						<path
							id="stampPath"
							d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0"
						></path>
					</defs>
					<text>
						<textPath href="#stampPath">DIMAS PUTRA · FRONTEND · INDONESIA ·</textPath>
					</text>
					<rect x="56.5" y="56.5" width="7" height="7" fill="var(--accent)"></rect>
				</svg>
			</div>
		</div>
	</div>

	<div class="ticker mt-14 lg:mt-20" data-ticker>
		<div class="ticker-track" data-ticker-track>
			<div class="ticker-group">
				{tickerItems.map((item) => <span class="ticker-item">{item}</span>)}
			</div>
			<div class="ticker-group" aria-hidden="true">
				{tickerItems.map((item) => <span class="ticker-item">{item}</span>)}
			</div>
		</div>
		<button
			class="ticker-control"
			type="button"
			data-ticker-toggle
			aria-pressed="false"
			aria-label="Pause the scrolling text"
		>
			Pause
		</button>
	</div>
</section>
