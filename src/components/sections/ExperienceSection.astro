---
import ChapterLabel from '../ChapterLabel.astro';

const roles = [
	{
		period: '2022 - now',
		role: 'Lead Frontend Developer',
		company: 'PT. Monex Investindo Futures (MIFX)',
		points: [
			'Rebuilt the MIFX website with Next.js.',
			'Built a CRM dashboard for back office and sales.',
			'Built the website and CRM dashboard for AMB Megatrend.',
			'Led the frontend team through code review and mentoring.',
			'Kept pages performing at a Lighthouse score of 95+.',
		],
	},
	{
		period: '2020 - 2022',
		role: 'Frontend Developer',
		company: 'PT. Boomboomcar Media Indonesia (DXTR Asia)',
		points: [
			'Built responsive web and PWA for AYO SRC Sampoerna.',
			'Built the AYO SRC mobile app with React Native.',
			'Handled UX, accessibility, and performance across devices.',
		],
	},
	{
		period: '2019 - 2020',
		role: 'Fullstack Developer',
		company: 'PT. Multi Kontrol Nusantara (Bakrie Company)',
		points: [
			'Developed an IoT dashboard for real-time data monitoring.',
			'Built LoRa-based IoT solutions for long-range communication.',
			'Implemented the UI with AngularJS and field data integration.',
		],
	},
	{
		period: '2017',
		role: 'Backend Developer',
		company: 'PT. Lapi Divusi',
		points: [
			'Integrated the SKKMIGAS backend with Laravel.',
			'Kept data flowing between frontend and backend applications.',
			'Supported operational and regulatory needs in the energy sector.',
		],
	},
];
---

<section id="experience" class="section-tight">
	<div class="shell">
		<ChapterLabel index="04" title="Experience" note="2017 to now" />

		<div class="mt-12 grid gap-10 lg:grid-cols-[0.78fr_1.22fr] lg:gap-20">
			<div class="lg:sticky lg:top-28 lg:self-start">
				<h2 class="display-l text-balance" data-reveal="up">Seven years, four teams.</h2>
				<p class="mt-6 max-w-[44ch] text-base leading-8 text-muted" data-reveal="up" style="--d: 100ms">
					From Laravel backend to frontend, then leading the frontend team at MIFX. Each role added a layer: reading
					a system, holding the UI together, and getting a team moving.
				</p>
				<p class="mt-8 font-mono text-[10px] uppercase leading-6 tracking-[0.14em] text-muted" data-reveal="up" style="--d: 180ms">
					Open any role to see the detail.
				</p>
			</div>

			<div class="border-t border-line">
				{roles.map((job, i) => (
					<div class:list={['exp-item', { 'is-open': i === 0 }]} data-accordion data-reveal="up" style={`--d: ${i * 70}ms`}>
						<h3>
							<button
								class="exp-trigger"
								type="button"
								id={`exp-trigger-${i}`}
								aria-expanded={i === 0 ? 'true' : 'false'}
								aria-controls={`exp-panel-${i}`}
								data-accordion-trigger
							>
								<span class="exp-year">{job.period}</span>
								<span class="exp-role">{job.role}</span>
								<span class="exp-company">{job.company}</span>
								<span class="exp-indicator" aria-hidden="true"></span>
							</button>
						</h3>
						<div
							class="exp-panel"
							id={`exp-panel-${i}`}
							role="region"
							aria-labelledby={`exp-trigger-${i}`}
							data-accordion-panel
						>
							<div>
								<ul class="exp-body grid gap-2 text-sm leading-7 text-muted">
									{job.points.map((point) => (
										<li>{point}</li>
									))}
								</ul>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</div>
</section>
