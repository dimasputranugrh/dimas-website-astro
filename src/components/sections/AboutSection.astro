---
import ChapterLabel from '../ChapterLabel.astro';

const principles = [
	'Clear hierarchy on every screen.',
	'Components that can be reused.',
	'Performance that doesn\'t make people wait.',
	'Accessibility from the start, not bolted on at the end.',
];
---

<section id="about" class="section">
	<div class="shell">
		<ChapterLabel index="01" title="About" note="Background and how I work" />

		<div class="mt-12 grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
			<div class="min-w-0">
				<h2 class="display-l text-balance" data-reveal="up">
					I work between design and code.
				</h2>

				<figure class="mt-10 border-t border-line pt-6" data-reveal="up" style="--d: 100ms">
					<blockquote class="display-m text-pretty">
						Tidy code isn't the end goal. The goal is people using the product without thinking about it.
					</blockquote>
				</figure>

				<dl class="mt-10 grid gap-5 text-sm" data-reveal="up" style="--d: 180ms">
					<div class="grid gap-1 border-t border-line pt-4">
						<dt class="overline text-muted">Current role</dt>
						<dd class="font-semibold">Lead Frontend Developer, MIFX</dd>
					</div>
					<div class="grid gap-1 border-t border-line pt-4">
						<dt class="overline text-muted">Education</dt>
						<dd class="font-semibold">Computer Science, Universitas Komputer Indonesia, 2014-2019</dd>
					</div>
				</dl>
			</div>

			<div class="min-w-0">
				<div class="grid max-w-[52ch] gap-6 text-base leading-8 text-muted" data-reveal="up" style="--d: 120ms">
					<p>
						I'm Dimas Putra, Lead Frontend Developer at MIFX. The last seven years have been spent in the browser:
						turning design into components, keeping interfaces consistent, and making sure pages stay fast as they
						grow.
					</p>
					<p>
						I'm most useful when a team needs someone who can read a design, push back on the details that don't
						hold up, and turn it into code that can be maintained. I also lead the frontend team through code review
						and mentoring.
					</p>
				</div>

				<div class="mt-10">
					<div class="overline text-muted" data-reveal="line">What I look after</div>
					<ul class="mt-5 grid gap-x-8 gap-y-4 sm:grid-cols-2">
						{principles.map((item, i) => (
							<li class="flex items-start gap-3 text-sm leading-7" data-reveal="up" style={`--d: ${240 + i * 70}ms`}>
								<span class="mt-3 h-1.5 w-1.5 flex-none bg-accent" aria-hidden="true"></span>
								<span>{item}</span>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</div>
</section>
