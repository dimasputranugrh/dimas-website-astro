---
import ChapterLabel from '../ChapterLabel.astro';

const groups = [
	{
		title: 'Frontend',
		note: 'Interfaces that are fast and easy to maintain, from SSR to PWA.',
		tags: ['React', 'Next.js', 'React Native', 'AngularJS', 'TypeScript', 'SSR', 'PWA'],
	},
	{
		title: 'UI / Styling',
		note: 'A visual system that stays consistent, from tokens to components.',
		tags: ['Design system', 'Tailwind CSS', 'SASS', 'Material UI', 'Accessibility'],
	},
	{
		title: 'Data & API',
		note: 'Wiring UI to data without turning state into a mess.',
		tags: ['REST API', 'GraphQL', 'Laravel', 'PostgreSQL', 'Redux', 'Zustand'],
	},
	{
		title: 'Workflow',
		note: 'Code review, tests, and pipelines that keep quality steady.',
		tags: ['Git', 'Code review', 'Jest', 'React Testing Library', 'GitLab CI', 'Docker'],
	},
];
---

<section id="skills" class="section-tight">
	<div class="shell">
		<ChapterLabel index="02" title="Skills" note="Four areas, one standard" />

		<div class="mt-10 grid gap-6 lg:grid-cols-[0.72fr_1.28fr] lg:items-end lg:gap-16">
			<h2 class="display-l text-balance" data-reveal="up">Tools I use every day.</h2>
			<p class="max-w-[52ch] text-base leading-8 text-muted" data-reveal="up" style="--d: 100ms">
				Not a long list to look complete. These are the tools I actually use to ship products, keep quality up, and
				help a team move without drama.
			</p>
		</div>

		<div class="mt-10 border-t border-line">
			{groups.map((group, i) => (
				<div class="skill-row" data-reveal="up" style={`--d: ${i * 80}ms`}>
					<span class="skill-index overline text-muted" aria-hidden="true">0{i + 1}</span>
					<h3 class="display-m">{group.title}</h3>
					<div class="min-w-0">
						<p class="skill-note max-w-[44ch] text-sm leading-7">{group.note}</p>
						<p class="skill-tag mt-2.5">{group.tags.join(' · ')}</p>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
