---
import Layout from '../layouts/Layout.astro';

const services = [
	{
		k: 'Discovery & architecture',
		v: 'Scope, data model, integration map, and the risks that surface six weeks after kickoff. Written down before anyone opens an editor.',
		o: 'Technical brief · data model · delivery plan',
	},
	{
		k: 'Company website',
		v: 'Profile, catalogue, or landing page that loads fast, reads well on a phone, and can be edited by staff without calling a developer.',
		o: 'Marketing site · CMS · analytics · SEO basics',
	},
	{
		k: 'CRM',
		v: 'Leads, pipeline stages, follow-up reminders, and a record of every conversation. Built around how the sales team already works, not the other way round.',
		o: 'Lead intake · pipeline · tasks · reporting',
	},
	{
		k: 'POS & inventory',
		v: 'Cashier screen, stock movements, receipts, and daily close. Works on a cheap tablet, survives a dropped connection.',
		o: 'Sales · stock · receipts · shift report',
	},
	{
		k: 'Business apps',
		v: 'HRIS and payroll, booking and scheduling, LMS, invoicing, clinic and workshop records. The system a business keeps in spreadsheets until it hurts.',
		o: 'Roles and access · approvals · exports',
	},
	{
		k: 'AI assistants',
		v: 'An assistant that answers from the company’s own documents, drafts replies, and hands over to a human when it is unsure instead of inventing an answer.',
		o: 'Document search · drafting · human handover',
	},
	{
		k: 'Automation & integration',
		v: 'WhatsApp and Telegram bots, scheduled jobs, API plumbing between tools that were never meant to talk, and the reporting that should never need a human.',
		o: 'Running jobs · alerting · runbook',
	},
	{
		k: 'Data & reporting',
		v: 'One source of truth, refreshed on schedule, with access rules that hold. Numbers you can defend in a meeting.',
		o: 'Pipelines · reporting surface · access rules',
	},
];

const also = [
	'Company profile',
	'Online store',
	'Booking & reservations',
	'HRIS & payroll',
	'Attendance',
	'Invoicing',
	'Helpdesk',
	'LMS',
	'Clinic records',
	'Inventory',
	'Membership',
	'Fleet & delivery',
	'Document management',
	'WhatsApp bot',
	'Telegram bot',
	'Payment integration',
];

const steps = [
	['Brief', 'The problem in plain words. What breaks today, what has to be true once it is fixed.'],
	['Assess', 'Constraints, existing systems, risk. A written scope before any code moves.'],
	['Build', 'Short cycles, a staging link in week one, one review thread per milestone.'],
	['Handover', 'Code, credentials, and documentation move to the owner. Support window in writing.'],
];

const work = [
	['Terminal', 'Analysis terminal for a discretionary trader', 'Live market data, structure levels, and pre-trade checks in one panel. Execution stays human.'],
	['Automation', 'Research agent for equity markets', 'Nightly data pull, scoring, and a written brief before the open.'],
	['Pipeline', '24/7 media render pipeline', 'Rendering, voice synthesis, subtitles, and publishing for a channel at 25,000 subscribers.'],
	['Delivery', 'Client-facing web builds', 'Landing pages, catalogues, and internal tools on fixed scope.'],
];

const stack = ['TypeScript', 'React', 'Next.js', 'Astro', 'Node', 'Python', 'PostgreSQL', 'Docker', 'Linux'];

const spec = [
	['Scope', 'Fixed, agreed in writing'],
	['Cadence', 'Weekly build reviews'],
	['Handover', 'Code, access, docs'],
	['Timezone', 'WIB, GMT+7'],
];
---

<Layout
	title="MIDS CONS — IT consulting and digital delivery"
	description="Independent IT consultancy. Discovery, product engineering, automation, and data delivery. One engineer, direct, fixed scope."
	theme="dark"
>
	<div class="site">
		<a
			class="skip focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:border focus:border-white focus:bg-black focus:px-4 focus:py-2 focus:text-sm"
			href="#main">Skip to content</a
		>

		<div class="utility">
			<div class="wrap utility-inner">
				<span>MIDS CONS</span>
				<span class="utility-mid">Independent IT consultancy · Jakarta / remote</span>
				<span class="utility-clock">WIB <span data-clock>--:--</span></span>
			</div>
		</div>

		<header class="bar" data-header>
			<div class="wrap bar-inner">
				<a class="mark" href="/" aria-label="MIDS CONS, home">
					<span class="mark-block" aria-hidden="true"></span>
					<span class="mark-text">MIDS<span class="accent">//</span>CONS</span>
				</a>

				<nav class="nav" aria-label="Main navigation">
					<a href="#services">Services</a>
					<a href="#approach">Approach</a>
					<a href="#work">Work</a>
					<a href="#contact">Contact</a>
					<a class="nav-aux" href="/dimas-profile">Profile</a>
				</nav>

				<div class="bar-actions">
					<button class="ghost-btn square" type="button" data-theme-toggle aria-label="Switch theme">
						<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="theme-icon">
							<circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
							<path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"></path>
						</svg>
					</button>
					<a class="solid-btn" href="mailto:dimasputranugrh@gmail.com?subject=Project%20brief"
						>Start a brief<span class="arr" aria-hidden="true">→</span></a
					>
				</div>
			</div>
		</header>

		<main id="main">
			<section class="hero">
				<div class="wrap hero-grid">
					<div class="hero-copy">
						<p class="status" data-reveal="up">
							<span class="pulse" aria-hidden="true"></span>Available for new engagements
						</p>

						<h1 class="hero-title" data-reveal="up" style="--d: 60ms">
							Software that holds up in production.
						</h1>

						<p class="hero-sub" data-reveal="up" style="--d: 120ms">
							I design and build the systems small teams actually run on: internal tools, integrations, automation,
							and the data plumbing underneath. One engineer, direct, no account layer between us.
						</p>

						<div class="cta-row" data-reveal="up" style="--d: 180ms">
							<a class="solid-btn" href="mailto:dimasputranugrh@gmail.com?subject=Project%20brief"
								>Send a brief<span class="arr" aria-hidden="true">→</span></a
							>
							<a class="ghost-btn" href="#approach">How it runs</a>
						</div>
					</div>

					<aside class="spec" data-reveal="up" style="--d: 240ms" aria-label="Engagement terms">
						<div class="spec-head">
							<span>Engagement</span>
							<span class="spec-id">SPEC 01</span>
						</div>
						<dl>
							{spec.map(([k, v]) => (
								<div class="spec-row">
									<dt>{k}</dt>
									<dd>{v}</dd>
								</div>
							))}
						</dl>
						<div class="spec-foot">
							<span class="dot" aria-hidden="true"></span>
							Reply within one business day
						</div>
					</aside>
				</div>
			</section>

			<section id="services" class="band">
				<div class="wrap">
					<div class="band-head" data-reveal="up">
						<h2 class="band-title">Services</h2>
						<p class="band-note">Websites, CRM, POS, business apps. Scope agreed before work starts.</p>
					</div>

					<div class="cards">
						{services.map((s, i) => (
							<article class="card" data-reveal="up" style={`--d: ${i * 60}ms`}>
								<p class="card-index">0{i + 1}</p>
								<h3>{s.k}</h3>
								<p class="card-body">{s.v}</p>
								<p class="card-meta">{s.o}</p>
							</article>
						))}
					</div>

					<div class="also" data-reveal="up">
						<p class="also-label">Also delivered</p>
						<ul>
							{also.map((a) => (
								<li>{a}</li>
							))}
						</ul>
					</div>
				</div>
			</section>

			<section id="approach" class="band">
				<div class="wrap">
					<div class="band-head" data-reveal="up">
						<h2 class="band-title">Approach</h2>
						<p class="band-note">Boring process. Interesting problems.</p>
					</div>

					<ol class="steps">
						{steps.map(([k, v], i) => (
							<li data-reveal="up" style={`--d: ${i * 60}ms`}>
								<span class="step-n">0{i + 1}</span>
								<span class="step-k">{k}</span>
								<span class="step-v">{v}</span>
							</li>
						))}
					</ol>
				</div>
			</section>

			<section id="work" class="band">
				<div class="wrap">
					<div class="band-head" data-reveal="up">
						<h2 class="band-title">Work</h2>
						<p class="band-note">Selected builds, running in production.</p>
					</div>

					<div class="rows">
						{work.map(([tag, title, detail], i) => (
							<article class="row" data-reveal="up" style={`--d: ${i * 60}ms`}>
								<span class="row-tag">{tag}</span>
								<h3 class="row-title">{title}</h3>
								<p class="row-detail">{detail}</p>
							</article>
						))}
					</div>

					<div class="stack" data-reveal="up">
						<span class="stack-label">Stack</span>
						<ul>
							{stack.map((s) => (
								<li>{s}</li>
							))}
						</ul>
					</div>
				</div>
			</section>

			<section id="contact" class="band band-last">
				<div class="wrap contact-grid">
					<div data-reveal="up">
						<h2 class="contact-title">Bring the part that keeps breaking.</h2>
						<p class="contact-sub">
							A few lines is enough: what the business does, what is failing, what a fix is worth. If it is not my
							kind of problem, you will hear that too.
						</p>
					</div>
					<div class="contact-actions" data-reveal="up" style="--d: 80ms">
						<a class="solid-btn wide" href="mailto:dimasputranugrh@gmail.com?subject=Project%20brief">
							dimasputranugrh@gmail.com<span class="arr" aria-hidden="true">→</span>
						</a>
						<a class="ghost-btn wide" href="/dimas-profile">Engineer profile</a>
					</div>
				</div>
			</section>
		</main>

		<footer class="foot">
			<div class="wrap foot-inner">
				<span class="mark-text">MIDS<span class="accent">//</span>CONS</span>
				<nav aria-label="Footer links">
					<a href="mailto:dimasputranugrh@gmail.com">Email</a>
					<a href="/dimas-profile">Profile</a>
					<a href="https://www.linkedin.com/in/dimasputranugrh/" target="_blank" rel="noreferrer">LinkedIn</a>
				</nav>
				<span class="foot-note">© {new Date().getFullYear()} MIDS CONS</span>
			</div>
		</footer>
	</div>

	<script src="../scripts/landing.ts"></script>

	<style>
		.site {
			--bg: #08090a;
			--surface: rgba(255, 255, 255, 0.022);
			--surface-2: rgba(255, 255, 255, 0.045);
			--line: rgba(255, 255, 255, 0.085);
			--line-soft: rgba(255, 255, 255, 0.05);
			--fg: #f4f1ea;
			--fg-2: #b9b3a8;
			--fg-3: #9c968c;
			--acc: #ff5533;
			background: var(--bg);
			color: var(--fg);
			font-family: var(--font-sans);
			letter-spacing: -0.011em;
			min-height: 100dvh;
			transition: background-color 220ms ease, color 220ms ease;
		}

		:global(html[data-theme='light']) .site {
			--bg: #f2ede4;
			--surface: rgba(0, 0, 0, 0.022);
			--surface-2: rgba(0, 0, 0, 0.05);
			--line: rgba(0, 0, 0, 0.16);
			--line-soft: rgba(0, 0, 0, 0.08);
			--fg: #0c0b0a;
			--fg-2: #47423b;
			--fg-3: #6f685e;
			--acc: #c2401e;
		}

		:global(html[data-theme='light']) .solid-btn {
			background: #0c0b0a;
			border-color: #0c0b0a;
			color: #f2ede4;
		}

		.wrap {
			width: 100%;
			max-width: 1180px;
			margin-inline: auto;
			padding-inline: 1.5rem;
		}

		@media (min-width: 1024px) {
			.wrap {
				padding-inline: 2.5rem;
			}
		}

		.accent {
			color: var(--acc);
		}

		/* utility strip */
		.utility {
			border-bottom: 1px solid var(--line-soft);
			font-family: var(--font-mono);
			font-size: 10px;
			letter-spacing: 0.16em;
			text-transform: uppercase;
			color: var(--fg-3);
		}

		.utility-inner {
			display: flex;
			height: 34px;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
		}

		.utility-mid {
			display: none;
		}

		@media (min-width: 768px) {
			.utility-mid {
				display: block;
			}
		}

		/* header */
		.bar {
			position: sticky;
			top: 0;
			z-index: 40;
			background: var(--bg);
			border-bottom: 1px solid transparent;
			transition: border-color 250ms ease;
		}

		.bar.is-scrolled {
			border-bottom-color: var(--line);
		}

		.bar-inner {
			display: flex;
			height: 64px;
			align-items: center;
			justify-content: space-between;
			gap: 1.5rem;
		}

		.mark {
			display: inline-flex;
			align-items: center;
			gap: 0.65rem;
			color: var(--fg);
			text-decoration: none;
		}

		.mark-block {
			width: 14px;
			height: 14px;
			background: var(--acc);
		}

		.mark-text {
			font-family: var(--font-mono);
			font-size: 13px;
			font-weight: 500;
			letter-spacing: 0.04em;
		}

		.nav {
			display: none;
			align-items: center;
			gap: 1.6rem;
			font-size: 13px;
			color: var(--fg-2);
		}

		@media (min-width: 900px) {
			.nav {
				display: flex;
			}
		}

		.nav a {
			transition: color 160ms ease;
		}

		.nav a:hover {
			color: var(--fg);
		}

		.nav-aux {
			color: var(--fg-3);
		}

		.bar-actions {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}

		/* buttons */
		.solid-btn,
		.ghost-btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 0.55rem;
			height: 38px;
			padding: 0 0.95rem;
			border-radius: 3px;
			font-size: 13px;
			font-weight: 500;
			letter-spacing: -0.005em;
			transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
		}

		.solid-btn {
			background: var(--fg);
			color: #0a0a0b;
			border: 1px solid var(--fg);
		}

		.solid-btn:hover {
			background: var(--acc);
			border-color: var(--acc);
			color: #fff;
		}

		.ghost-btn {
			background: var(--surface);
			color: var(--fg-2);
			border: 1px solid var(--line);
		}

		.ghost-btn:hover {
			background: var(--surface-2);
			color: var(--fg);
		}

		.ghost-btn.square {
			width: 38px;
			height: 38px;
			padding: 0;
		}

		.arr {
			font-size: 12px;
			transition: transform 160ms ease;
		}

		.solid-btn:hover .arr {
			transform: translateX(2px);
		}

		.wide {
			width: 100%;
		}

		/* hero */
		.hero {
			padding-block: clamp(3.5rem, 7vw, 6.5rem) clamp(2.5rem, 5vw, 4.5rem);
			border-bottom: 1px solid var(--line-soft);
		}

		.hero-grid {
			display: grid;
			gap: clamp(2.5rem, 5vw, 4.5rem);
			grid-template-columns: 1fr;
		}

		@media (min-width: 960px) {
			.hero-grid {
				grid-template-columns: minmax(0, 1.55fr) minmax(0, 0.85fr);
				align-items: start;
			}
		}

		.status {
			display: inline-flex;
			align-items: center;
			gap: 0.55rem;
			font-family: var(--font-mono);
			font-size: 10px;
			letter-spacing: 0.18em;
			text-transform: uppercase;
			color: var(--fg-3);
		}

		.pulse {
			width: 6px;
			height: 6px;
			border-radius: 999px;
			background: var(--acc);
			box-shadow: 0 0 0 0 color-mix(in srgb, var(--acc) 60%, transparent);
			animation: pulse 2.6s ease-out infinite;
		}

		@keyframes pulse {
			0% {
				box-shadow: 0 0 0 0 color-mix(in srgb, var(--acc) 55%, transparent);
			}
			70% {
				box-shadow: 0 0 0 7px transparent;
			}
			100% {
				box-shadow: 0 0 0 0 transparent;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.pulse {
				animation: none;
			}
		}

		.hero-title {
			margin-top: 1.5rem;
			font-family: var(--font-sans);
			font-size: clamp(2.3rem, 5.6vw, 4rem);
			font-weight: 500;
			line-height: 1.02;
			letter-spacing: -0.035em;
			max-width: 20ch;
			text-wrap: balance;
		}

		.hero-sub {
			margin-top: 1.4rem;
			max-width: 54ch;
			font-size: clamp(0.98rem, 1.4vw, 1.08rem);
			line-height: 1.7;
			color: var(--fg-2);
		}

		.cta-row {
			margin-top: 2rem;
			display: flex;
			flex-wrap: wrap;
			gap: 0.6rem;
		}

		/* spec panel */
		.spec {
			margin-top: 2.1rem;
			border: 1px solid var(--line);
			background: var(--surface);
			border-radius: 4px;
			font-family: var(--font-mono);
			font-size: 11px;
		}

		.spec-head,
		.spec-foot {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.7rem 0.95rem;
			letter-spacing: 0.16em;
			text-transform: uppercase;
			color: var(--fg-3);
		}

		.spec-head {
			border-bottom: 1px solid var(--line-soft);
		}

		.spec-id {
			color: color-mix(in srgb, var(--fg-3) 70%, transparent);
		}

		.spec dl {
			margin: 0;
		}

		.spec-row {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			gap: 1rem;
			padding: 0.62rem 0.95rem;
			border-bottom: 1px solid var(--line-soft);
		}

		.spec-row dt {
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--fg-3);
		}

		.spec-row dd {
			margin: 0;
			color: var(--fg-2);
			text-align: right;
		}

		.spec-foot {
			gap: 0.5rem;
			justify-content: flex-start;
			color: var(--fg-3);
			border-top: 1px solid var(--line-soft);
		}

		.spec-foot .dot {
			width: 5px;
			height: 5px;
			background: var(--acc);
			border-radius: 999px;
		}

		/* bands */
		.band {
			padding-block: clamp(3rem, 6vw, 5rem);
			border-bottom: 1px solid var(--line-soft);
		}

		.band-last {
			border-bottom: 0;
		}

		.band-head {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			gap: 2rem;
			flex-wrap: wrap;
			padding-bottom: 1.5rem;
		}

		.band-title {
			font-family: var(--font-mono);
			font-size: 11px;
			font-weight: 500;
			letter-spacing: 0.2em;
			text-transform: uppercase;
			color: var(--fg);
		}

		.band-note {
			font-size: 13px;
			color: var(--fg-3);
		}

		/* service cards */
		.cards {
			display: grid;
			grid-template-columns: 1fr;
			border-top: 1px solid var(--line);
		}

		@media (min-width: 768px) {
			.cards {
				grid-template-columns: 1fr 1fr;
			}
		}

		.card {
			padding: 1.9rem 1.6rem 1.9rem 0;
			border-bottom: 1px solid var(--line);
			transition: background-color 200ms ease;
		}

		@media (min-width: 768px) {
			.card {
				padding: 2.2rem 2rem 2.2rem 0;
			}

			.card:nth-child(odd) {
				padding-right: 2.5rem;
				border-right: 1px solid var(--line);
			}

			.card:nth-child(even) {
				padding-left: 2.5rem;
			}
		}

		.card:hover {
			background: var(--surface);
		}

		.card-index {
			font-family: var(--font-mono);
			font-size: 10px;
			letter-spacing: 0.18em;
			color: var(--acc);
		}

		.card h3 {
			margin-top: 0.9rem;
			font-family: var(--font-sans);
			font-size: 1.15rem;
			font-weight: 500;
			letter-spacing: -0.02em;
			color: var(--fg);
		}

		.card-body {
			margin-top: 0.7rem;
			max-width: 42ch;
			font-size: 14px;
			line-height: 1.65;
			color: var(--fg-2);
		}

		.card-meta {
			margin-top: 1.2rem;
			font-family: var(--font-mono);
			font-size: 10px;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--fg-3);
		}

		.also {
			margin-top: 2.5rem;
			display: grid;
			gap: 0.9rem;
		}

		@media (min-width: 900px) {
			.also {
				grid-template-columns: 8rem minmax(0, 1fr);
				gap: 2rem;
			}
		}

		.also-label {
			font-family: var(--font-mono);
			font-size: 10px;
			letter-spacing: 0.18em;
			text-transform: uppercase;
			color: var(--fg-3);
		}

		.also ul {
			display: flex;
			flex-wrap: wrap;
			gap: 0.3rem 0.75rem;
			margin: 0;
			padding: 0;
			list-style: none;
			font-size: 13px;
			color: var(--fg-2);
		}

		.also li {
			border: 1px solid var(--line-soft);
			padding: 0.2rem 0.55rem;
			border-radius: 2px;
		}

		/* steps */
		.steps {
			border-top: 1px solid var(--line);
			counter-reset: step;
		}

		.steps li {
			display: grid;
			grid-template-columns: 2.5rem 1fr;
			gap: 0.4rem 1rem;
			padding: 1.4rem 0;
			border-bottom: 1px solid var(--line-soft);
		}

		@media (min-width: 768px) {
			.steps li {
				grid-template-columns: 4rem 12rem minmax(0, 1fr);
				align-items: baseline;
				gap: 2rem;
				padding: 1.6rem 0;
			}
		}

		.step-n {
			font-family: var(--font-mono);
			font-size: 10px;
			letter-spacing: 0.18em;
			color: var(--acc);
		}

		.step-k {
			font-size: 15px;
			font-weight: 500;
			letter-spacing: -0.015em;
		}

		.step-v {
			font-size: 14px;
			line-height: 1.65;
			color: var(--fg-2);
			max-width: 62ch;
		}

		/* work rows */
		.rows {
			border-top: 1px solid var(--line);
		}

		.row {
			display: grid;
			grid-template-columns: 1fr;
			gap: 0.4rem;
			padding: 1.5rem 0;
			border-bottom: 1px solid var(--line-soft);
			transition: padding-left 200ms ease, background-color 200ms ease;
		}

		@media (min-width: 900px) {
			.row {
				grid-template-columns: 8rem 22rem minmax(0, 1fr);
				align-items: baseline;
				gap: 2rem;
			}

			.row:hover {
				background: var(--surface);
				padding-left: 0.75rem;
			}
		}

		.row-tag {
			font-family: var(--font-mono);
			font-size: 10px;
			letter-spacing: 0.18em;
			text-transform: uppercase;
			color: var(--fg-3);
		}

		.row-title {
			font-size: 15px;
			font-weight: 500;
			letter-spacing: -0.015em;
		}

		.row-detail {
			font-size: 14px;
			line-height: 1.65;
			color: var(--fg-2);
		}

		/* stack */
		.stack {
			margin-top: 2.5rem;
			display: grid;
			gap: 1rem;
		}

		@media (min-width: 768px) {
			.stack {
				grid-template-columns: 8rem minmax(0, 1fr);
				gap: 2rem;
			}
		}

		.stack-label {
			font-family: var(--font-mono);
			font-size: 10px;
			letter-spacing: 0.18em;
			text-transform: uppercase;
			color: var(--fg-3);
		}

		.stack ul {
			display: flex;
			flex-wrap: wrap;
			gap: 0.35rem 0.9rem;
			margin: 0;
			padding: 0;
			list-style: none;
			font-family: var(--font-mono);
			font-size: 11px;
			letter-spacing: 0.06em;
			color: var(--fg-2);
		}

		.stack li + li::before {
			content: '·';
			margin-right: 0.9rem;
			color: var(--fg-3);
		}

		/* contact */
		.contact-grid {
			display: grid;
			gap: 2.5rem;
			grid-template-columns: 1fr;
		}

		@media (min-width: 960px) {
			.contact-grid {
				grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
				align-items: end;
				gap: 4rem;
			}
		}

		.contact-title {
			font-family: var(--font-sans);
			font-size: clamp(1.9rem, 4vw, 2.9rem);
			font-weight: 500;
			line-height: 1.05;
			letter-spacing: -0.032em;
			max-width: 22ch;
			text-wrap: balance;
		}

		.contact-sub {
			margin-top: 1.1rem;
			max-width: 52ch;
			font-size: 14px;
			line-height: 1.7;
			color: var(--fg-2);
		}

		.contact-actions {
			display: grid;
			gap: 0.55rem;
		}

		/* footer */
		.foot {
			border-top: 1px solid var(--line);
			padding-block: 1.6rem;
		}

		.foot-inner {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			font-family: var(--font-mono);
			font-size: 10px;
			letter-spacing: 0.16em;
			text-transform: uppercase;
			color: var(--fg-3);
		}

		.foot nav {
			display: flex;
			gap: 1.25rem;
		}

		.foot a:hover {
			color: var(--fg);
		}

		.skip {
			position: absolute;
			left: -9999px;
		}

		/* ponytail: no-JS fallback. Reveal-on-scroll hides content; without JS it must stay visible. */
		:global(html:not(.js) [data-reveal]) {
			opacity: 1 !important;
			transform: none !important;
		}
	</style>
</Layout>
