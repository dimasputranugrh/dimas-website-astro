---
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';

export interface Props {
	title?: string;
	description?: string;
	image?: string;
	theme?: 'light' | 'dark';
}

const {
	title = 'Dimas Putra, Lead Frontend Developer',
	description = 'Portfolio of Dimas Putra, Lead Frontend Developer. Seven years building web interfaces that load fast, stay consistent, and work for everyone.',
	image = '/brand/avatar-dark.png',
	theme = 'light',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="author" content="Dimas Putra" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#F2EDE4" data-theme-color />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={image} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={image} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<title>{title}</title>
		<script is:inline define:vars={{ forcedTheme: theme }}>
			(() => {
				const root = document.documentElement;
				root.classList.add('js');
				const forced = forcedTheme === 'light' || forcedTheme === 'dark' ? forcedTheme : '';
				let theme = forced || 'light';
				try {
					const stored = localStorage.getItem('theme');
					if (stored === 'light' || stored === 'dark') {
						theme = stored;
					} else if (!forced && window.matchMedia('(prefers-color-scheme: dark)').matches) {
						theme = 'dark';
					}
				} catch {
					theme = forced || 'light';
				}
				root.dataset.theme = theme;
			})();
		</script>
	</head>
	<body class="bg-paper font-sans text-ink antialiased">
		<slot />
	</body>
</html>
